generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  Principiante
  Intermedio
}

enum SessionStatus {
  PLAYING
  PAUSED
  ASKING
  COMPLETED
}

model Routine {
  id               String            @id
  order            Int               @default(0)
  name             String
  description      String            @db.Text
  difficulty       Difficulty
  estimatedMinutes Int
  category         String
  published        Boolean           @default(true)
  exercises        RoutineExercise[]
  sessions         Session[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Exercise {
  id               String            @id
  name             String
  description      String            @db.Text
  difficulty       Difficulty
  estimatedMinutes Int
  category         String
  routines         RoutineExercise[]
  movements        Movement[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model RoutineExercise {
  routineId  String
  exerciseId String
  order      Int
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@id([routineId, exerciseId])
  @@unique([routineId, order])
  @@index([exerciseId])
}

model Movement {
  id              String       @id
  exerciseId      String
  order           Int
  name            String
  description     String       @db.Text
  instruction     String       @db.Text
  durationSeconds Int
  voiceGuide      Json
  tips            Json
  image           String
  exercise        Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  questions       AIQuestion[]

  @@unique([exerciseId, order])
  @@index([exerciseId])
}

model Session {
  id                   String        @id
  routineId            String
  currentMovementIndex Int           @default(0)
  status               SessionStatus @default(PLAYING)
  startedAt            DateTime
  completedAt          DateTime?
  elapsedSeconds       Int           @default(0)
  routine              Routine       @relation(fields: [routineId], references: [id], onDelete: Restrict)
  questions            AIQuestion[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([routineId])
  @@index([status])
}

model AIQuestion {
  id         String   @id
  sessionId  String
  movementId String
  question   String   @db.Text
  answer     String   @db.Text
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  movement   Movement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([sessionId])
}
